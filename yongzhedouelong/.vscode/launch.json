{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot: Launch Project",
      "type": "godot",
      "request": "launch",
      "project": "${workspaceFolder}",
      "args": [
        "--path",
        "${workspaceFolder}",
        "--debug"
      ],
      "stopOnEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
