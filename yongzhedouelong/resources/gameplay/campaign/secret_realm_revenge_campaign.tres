[sub_resource type="Resource" id="Resource_act_01"]
script = ExtResource("1_act")
act_id = "act_01_sect_escape"
act_name = "第一幕：袭宗逃亡"
story_goal = "叛宗大师兄率敌袭击宗门，主角在师兄弟保护下边逃边战，最终躲入宗门秘境。"
primary_gameplay = "escape_tutorial"
reward_tier = "starter_kit"
boss_name = "叛宗先锋"
act_end_reveal = "主角进入秘境前看见大师兄正在搜寻宗门禁地线索。"

[sub_resource type="Resource" id="Resource_act_02"]
script = ExtResource("1_act")
act_id = "act_02_secret_realm"
act_name = "第二幕：宗门秘境"
story_goal = "主角暂时脱离宗门战场，在秘境中寻找生机、修复伤势、提升境界。"
primary_gameplay = "dungeon_room_clear"
uses_room_clear_routes = true
reward_tier = "cultivation_resources"
boss_name = "秘境守关妖兽"
act_end_reveal = "主角获得秘境核心认可，看见宗门外战火未熄，决定走出秘境。"

[sub_resource type="Resource" id="Resource_act_03"]
script = ExtResource("1_act")
act_id = "act_03_outer_counterattack"
act_name = "第三幕：秘境之外"
story_goal = "主角开始主动反击，猎杀参与袭宗的反派角色，夺取灵器法宝，逐步接近宗门核心战场。"
primary_gameplay = "dungeon_room_clear_counterattack"
uses_room_clear_routes = true
reward_tier = "artifact_build"
boss_name = "反派阵营干部"
act_end_reveal = "主角确认大师兄正在宗门深处启动禁忌阵法。"

[sub_resource type="Resource" id="Resource_act_04"]
script = ExtResource("1_act")
act_id = "act_04_sect_revenge"
act_name = "第四幕：宗门复仇"
story_goal = "主角正式杀回宗门，穿过沦陷的宗门区域，最终击败叛宗大师兄。"
primary_gameplay = "endgame_revenge_clear"
reward_tier = "endgame_tuning"
boss_name = "叛宗大师兄"
act_end_reveal = "大师兄败亡后，秘境核心或宗门仙器启动轮回，下一轮回到袭宗之夜。"

[resource]
